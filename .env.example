# BWFS Build-Time Configuration Variables
# These values are used during compilation and build process
# Runtime configuration (storage_path, max_block_bytes, mount_point) is in config.ini

# Filesystem Limits (compile-time constants)
MAX_FILES=1024
MAX_NAME_LEN=255

# Metadata Configuration (build-time)
META_FILENAME=bwfs_metadata.bin
BWFS_MAGIC=0x42574653u

# Storage and Export Directories (runtime for bwfs_export_images)
STORAGE_DIR=bwfs_storage
IMG_DIR=storage_images
